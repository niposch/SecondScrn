<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SecondScrn.Views.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="32,24" Spacing="12" MaxWidth="1100">
            <TextBlock Text="Diagnostics" Style="{StaticResource PageTitle}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Connection" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.DiagnosticsText, Mode=OneWay}" FontFamily="Consolas" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.NetworkText, Mode=OneWay}" Style="{StaticResource Caption}" IsTextSelectionEnabled="True" />
                    <TextBlock Text="{x:Bind ViewModel.DriverTitle, Mode=OneWay}" Style="{StaticResource Caption}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Video encoders" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.ActiveEncoderText, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.EncodersText, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <TextBlock Style="{StaticResource Caption}" Text="Only encoders that were verified to work are listed. SecondScrn never falls back to software encoding." />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Performance test" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="Measures how many frames per second each GPU encodes at a resolution, with the whole screen scrolling (harder than typical desktop use). Screen capture and Wi-Fi are not included, so a real stream can be somewhat slower." />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ComboBox Header="Resolution" ItemsSource="{x:Bind ViewModel.BenchSizeOptions, Mode=OneWay}"
                                  SelectedIndex="{x:Bind ViewModel.BenchSizeIndex, Mode=TwoWay}" MinWidth="220" />
                        <ComboBox Header="Frame rate" ItemsSource="{x:Bind ViewModel.BenchFpsOptions}"
                                  SelectedIndex="{x:Bind ViewModel.BenchFpsIndex, Mode=TwoWay}" MinWidth="120" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Run test" Click="OnBenchmark" IsEnabled="{x:Bind ViewModel.CanRunBenchmark, Mode=OneWay}" />
                        <ProgressRing IsActive="{x:Bind ViewModel.BenchmarkRunning, Mode=OneWay}" Width="20" Height="20" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.BenchmarkText, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Export diagnostics…" Click="OnExport" Style="{StaticResource AccentButtonStyle}" />
                <Button Content="Open log folder" Click="OnOpenLogs" />
                <TextBlock Text="Exports contain statistics and logs with keys, codes and identities removed." VerticalAlignment="Center" Style="{StaticResource Caption}" />
            </StackPanel>
            <Border Style="{StaticResource Card}" Padding="0">
                <TextBox x:Name="Logs" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12" Height="420"
                         BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
