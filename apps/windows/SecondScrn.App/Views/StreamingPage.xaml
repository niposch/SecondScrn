<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SecondScrn.Views.StreamingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="32,24" Spacing="12" MaxWidth="1000">
            <TextBlock Text="Streaming" Style="{StaticResource PageTitle}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <ComboBox Header="Preset" ItemsSource="{x:Bind ViewModel.Presets}" SelectedIndex="{x:Bind ViewModel.PresetIndex, Mode=TwoWay}" MinWidth="260" />
                    <TextBlock Style="{StaticResource Caption}" Text="A preset sets resolution, frame rate and bitrate limits for the connected tablet; you can still change resolution and frame rate afterwards. Automatic: native resolution at 60 fps, bitrate follows the network. High quality: about twice the bitrate for sharper text and video, slightly more latency. Smooth: 75 % resolution at up to 120 fps. Weak Wi-Fi: 67 % resolution at 30 fps with a low bitrate." />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Advanced" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ComboBox Header="Codec" ItemsSource="{x:Bind ViewModel.Codecs}" SelectedIndex="{x:Bind ViewModel.CodecIndex, Mode=TwoWay}" MinWidth="260" />
                    <ComboBox Header="Maximum frame rate" ItemsSource="{x:Bind ViewModel.FpsOptions}" SelectedIndex="{x:Bind ViewModel.MaxFpsIndex, Mode=TwoWay}" MinWidth="260" />
                    <NumberBox Header="Maximum bitrate (Mbit/s, 0 = automatic)" Minimum="0" Maximum="150" SpinButtonPlacementMode="Inline"
                               Width="260" HorizontalAlignment="Left" Value="{x:Bind ViewModel.MaxBitrate, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource Caption}" Text="Codec, frame rate and bitrate limits apply to the next connection." />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Video encoder" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.EncoderGpuChoiceVisibility, Mode=OneWay}">
                        <ComboBox Header="Encode on" ItemsSource="{x:Bind ViewModel.EncoderGpuOptions, Mode=OneWay}"
                                  SelectedIndex="{x:Bind ViewModel.EncoderGpuIndex, Mode=TwoWay}" MinWidth="260" />
                        <InfoBar IsOpen="{x:Bind ViewModel.RestartRequired, Mode=OneWay}" IsClosable="False" Severity="Informational"
                                 Title="Restart SecondScrn to switch GPUs"
                                 Message="Windows assigns SecondScrn to a GPU when it starts. A connected tablet reconnects after the restart.">
                            <InfoBar.ActionButton>
                                <Button Content="Restart now" Click="OnRestart" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                        <InfoBar IsOpen="{x:Bind ViewModel.HasEncoderGpuProblem, Mode=OneWay}" IsClosable="False" Severity="Warning"
                                 Title="Encoder unavailable" Message="{x:Bind ViewModel.EncoderGpuProblem, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.ActiveEncoderText, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.EncodersText, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <TextBlock Style="{StaticResource Caption}" Text="Only encoders that were verified to work are listed. SecondScrn never falls back to software encoding." />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Encoder benchmark" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="Measures how many frames per second each GPU encodes at a resolution, with the whole screen scrolling (harder than typical desktop use). Screen capture and Wi-Fi are not included, so a real stream can be somewhat slower. Every GPU is measured, whichever is selected above." />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ComboBox Header="Resolution" ItemsSource="{x:Bind ViewModel.BenchSizeOptions, Mode=OneWay}"
                                  SelectedIndex="{x:Bind ViewModel.BenchSizeIndex, Mode=TwoWay}" MinWidth="220" />
                        <ComboBox Header="Frame rate" ItemsSource="{x:Bind ViewModel.BenchFpsOptions}"
                                  SelectedIndex="{x:Bind ViewModel.BenchFpsIndex, Mode=TwoWay}" MinWidth="120" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Run benchmark" Click="OnBenchmark" IsEnabled="{x:Bind ViewModel.CanRunBenchmark, Mode=OneWay}" />
                        <ProgressRing IsActive="{x:Bind ViewModel.BenchmarkRunning, Mode=OneWay}" Width="20" Height="20" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.BenchmarkText, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
