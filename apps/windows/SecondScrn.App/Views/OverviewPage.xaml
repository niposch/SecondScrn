<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SecondScrn.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="32,24" Spacing="12" MaxWidth="1000" HorizontalAlignment="Stretch">
            <TextBlock Text="Overview" Style="{StaticResource PageTitle}" />

            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Severity="Warning" Title="Attention"
                     Message="{x:Bind ViewModel.LastError, Mode=OneWay}" IsClosable="False" />
            <InfoBar IsOpen="{x:Bind ViewModel.DriverNeedsInstall, Mode=OneWay}" Severity="Error"
                     Title="{x:Bind ViewModel.DriverTitle, Mode=OneWay}"
                     Message="The tablet appears as a real monitor through the Virtual Display Driver. Installing it requires administrator approval once.">
                <InfoBar.ActionButton>
                    <Button Content="Install driver…" Click="OnInstallDriver" />
                </InfoBar.ActionButton>
            </InfoBar>

            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7F4;" FontSize="36" VerticalAlignment="Top" Margin="0,4,0,0" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.ConnectionTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.ConnectionDetail, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock Text="{x:Bind ViewModel.HealthText, Mode=OneWay}" Style="{StaticResource Caption}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Disconnect" VerticalAlignment="Top"
                            Visibility="{x:Bind ViewModel.ConnectedVisibility, Mode=OneWay}" Click="OnDisconnect" />
                </Grid>
            </Border>

            <Grid ColumnSpacing="12" RowSpacing="12" Visibility="{x:Bind ViewModel.ConnectedVisibility, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel><TextBlock Text="Resolution" Style="{StaticResource Caption}" /><TextBlock Text="{x:Bind ViewModel.ResolutionText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" /></StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel><TextBlock Text="Frame rate" Style="{StaticResource Caption}" /><TextBlock Text="{x:Bind ViewModel.FpsText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" /></StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel><TextBlock Text="Bitrate" Style="{StaticResource Caption}" /><TextBlock Text="{x:Bind ViewModel.BitrateText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" /></StackPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <StackPanel><TextBlock Text="Latency" Style="{StaticResource Caption}" /><TextBlock Text="{x:Bind ViewModel.LatencyText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" /></StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel><TextBlock Text="Packet loss (before repair)" Style="{StaticResource Caption}" /><TextBlock Text="{x:Bind ViewModel.LossText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" /></StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Quality" Style="{StaticResource Caption}" />
                        <ComboBox ItemsSource="{x:Bind ViewModel.Presets}" SelectedIndex="{x:Bind ViewModel.PresetIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Quick actions" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Arrange displays in Windows…" Click="OnDisplaySettings" />
                        <Button Content="Show connection details" Click="OnDiagnostics" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.HostIdentity, Mode=OneWay}" Style="{StaticResource Caption}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
