<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SecondScrn.Views.DisplayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="32,24" Spacing="12" MaxWidth="1000">
            <TextBlock Text="Display" Style="{StaticResource PageTitle}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.DriverTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.DriverDetail, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Caption}" Text="SecondScrn uses the open-source Virtual Display Driver (VirtualDrivers, MIT licence, signed). It is installed once and is not changed by app updates." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Install driver…" Visibility="{x:Bind ViewModel.DriverInstallVisibility, Mode=OneWay}" Click="OnInstall" Style="{StaticResource AccentButtonStyle}" />
                        <Button Content="Check again" Click="OnRefresh" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Tablet display" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" Text="When a tablet connects, a monitor with the tablet's resolution and refresh rate is added to Windows, next to your other displays. Rotating the tablet switches the monitor between landscape and portrait. Changing the resolution here, on the tablet or in the Windows display settings takes effect immediately." />
                    <TextBlock Text="{x:Bind ViewModel.ConnectionDetail, Mode=OneWay}" Style="{StaticResource Caption}" />
                    <ComboBox Header="Resolution" MinWidth="280" ItemsSource="{x:Bind ViewModel.ResolutionLabels, Mode=OneWay}"
                              SelectedIndex="{x:Bind ViewModel.ResolutionIndex, Mode=TwoWay}"
                              IsEnabled="{x:Bind ViewModel.CanChangeResolution, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.ResolutionHint, Mode=OneWay}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    <ComboBox Header="Frame rate" MinWidth="280" ItemsSource="{x:Bind ViewModel.FrameRateLabels, Mode=OneWay}"
                              SelectedIndex="{x:Bind ViewModel.FrameRateIndex, Mode=TwoWay}"
                              IsEnabled="{x:Bind ViewModel.CanChangeResolution, Mode=OneWay}" />
                    <Button Content="Arrange displays and set scaling in Windows…" Click="OnDisplaySettings" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Keep the display after a disconnect" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Style="{StaticResource Caption}" Text="Short Wi-Fi interruptions then don't move your windows back to the main screen." />
                    <NumberBox Header="Seconds" Minimum="0" Maximum="600" SpinButtonPlacementMode="Inline" Width="200" HorizontalAlignment="Left"
                               Value="{x:Bind ViewModel.LingerSeconds, Mode=TwoWay}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
