<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SecondScrn.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SecondScrn.ViewModels">
    <ScrollViewer>
        <StackPanel Padding="32,24" Spacing="12" MaxWidth="1000">
            <TextBlock Text="Tablets" Style="{StaticResource PageTitle}" />
            <Border Style="{StaticResource Card}" Visibility="{x:Bind NoDevicesVisibility, Mode=OneWay}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Pair a new tablet" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" Text="Open SecondScrn on the tablet and choose this PC. The tablet shows a 6-digit code; SecondScrn asks you for it here. Only paired tablets can connect or send input." />
                </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{x:Bind ViewModel.Devices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DeviceItem">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="● connected" Foreground="SeaGreen" Visibility="{x:Bind ConnectedVisibility}" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Details}" Style="{StaticResource Caption}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" Header="Preset" MinWidth="170" Tag="{x:Bind}"
                                          SelectedIndex="{x:Bind PresetIndex}" SelectionChanged="OnPresetChanged">
                                    <x:String>Default preset</x:String>
                                    <x:String>Automatic</x:String>
                                    <x:String>High quality</x:String>
                                    <x:String>Smooth</x:String>
                                    <x:String>Weak Wi-Fi</x:String>
                                </ComboBox>
                                <ToggleSwitch Grid.Column="2" Header="Reconnect automatically" Tag="{x:Bind}"
                                              IsOn="{x:Bind AutoReconnect}" Toggled="OnAutoReconnectToggled" />
                                <Button Grid.Column="3" Content="Remove" VerticalAlignment="Center" Tag="{x:Bind}" Click="OnRemove" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Visibility="{x:Bind HasDevicesVisibility, Mode=OneWay}"
                       Text="A tablet's preset is remembered for it; choosing one on Home or on the tablet changes it here too. To pair another tablet, open SecondScrn on it and choose this PC." />
        </StackPanel>
    </ScrollViewer>
</Page>
