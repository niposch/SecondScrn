<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SecondScrn.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="32,24" Spacing="12" MaxWidth="1000">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Application" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ToggleSwitch Header="Start with Windows" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" />
                    <ToggleSwitch Header="Start minimized to the notification area" IsOn="{x:Bind ViewModel.StartMinimized, Mode=TwoWay}" />
                    <ToggleSwitch Header="Closing the window keeps SecondScrn running in the notification area" IsOn="{x:Bind ViewModel.CloseToTray, Mode=TwoWay}" />
                    <ComboBox Header="Appearance" ItemsSource="{x:Bind ViewModel.Themes}" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}" MinWidth="260" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Network" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBox Header="Name shown to tablets (empty = computer name)" Text="{x:Bind ViewModel.HostNameSetting, Mode=TwoWay}" MaxWidth="420" HorizontalAlignment="Left" Width="420" />
                    <ToggleSwitch Header="Let tablets on this network find this PC automatically" IsOn="{x:Bind ViewModel.Discoverable, Mode=TwoWay}" />
                    <NumberBox Header="Port" Minimum="1024" Maximum="65535" Width="200" HorizontalAlignment="Left" Value="{x:Bind ViewModel.Port, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource Caption}" Text="All connections are encrypted and only paired tablets are accepted. If Windows Firewall asks, allow SecondScrn on private networks." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Updates" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ToggleSwitch Header="Check for updates at startup" IsOn="{x:Bind ViewModel.CheckForUpdates, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CheckButton" Content="Check now" Click="OnCheckUpdates" />
                        <Button x:Name="InstallButton" Content="Install update and restart" Click="OnInstallUpdate" Visibility="Collapsed" Style="{StaticResource AccentButtonStyle}" />
                        <TextBlock x:Name="UpdateStatus" VerticalAlignment="Center" Style="{StaticResource Caption}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Troubleshooting" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ToggleSwitch Header="Detailed logging (takes effect after restart)" IsOn="{x:Bind ViewModel.VerboseLogging, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="6">
                    <TextBlock Text="About" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.Version, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.HostIdentity, Mode=OneWay}" Style="{StaticResource Caption}" />
                    <TextBlock Style="{StaticResource Caption}" Text="SecondScrn is open-source software under the MIT licence. It includes third-party components under their own licences." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <HyperlinkButton Content="Licence" Click="OnLicense" />
                        <HyperlinkButton Content="Third-party notices" Click="OnNotices" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
